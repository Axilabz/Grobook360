{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://grobook360.example/events/envelope.schema.json",
  "title": "EventEnvelope",
  "description": "Common envelope for every domain event. `event_id` is the consumer's idempotency key (at-least-once delivery => consumers MUST de-duplicate on it).",
  "type": "object",
  "required": [
    "event_id",
    "event_type",
    "event_version",
    "occurred_at",
    "tenant_id",
    "correlation_id",
    "producer",
    "payload"
  ],
  "additionalProperties": false,
  "properties": {
    "event_id": {
      "type": "string",
      "format": "uuid"
    },
    "event_type": {
      "type": "string"
    },
    "event_version": {
      "type": "integer",
      "minimum": 1
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time"
    },
    "tenant_id": {
      "type": "string",
      "format": "uuid"
    },
    "correlation_id": {
      "type": "string",
      "format": "uuid"
    },
    "causation_id": {
      "type": [
        "string",
        "null"
      ],
      "format": "uuid"
    },
    "producer": {
      "type": "string",
      "description": "Owning service, e.g. sales"
    },
    "payload": {
      "type": "object"
    }
  }
}