# Copy this file to .env and fill in real values.
# Never commit the .env file itself.

ENVIRONMENT=development

# postgresql://user:password@host:port/database_name
DATABASE_URL=postgresql://saas_app:changeme@localhost:5432/saas_mvp_dev
# --- Supabase (uncomment & fill; URL-encode special chars in the password) ---
# Runtime via transaction pooler:
# DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
# DATABASE_SSL=true
# DATABASE_USE_PGBOUNCER=true
# Alembic only (direct or session pooler, port 5432):
# MIGRATION_DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10
DATABASE_ECHO=false

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=changeme-generate-a-real-secret-at-least-32-characters-long
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

CORS_ALLOW_ORIGINS=["http://localhost:3000","http://localhost:5173"]

LOG_LEVEL=INFO

# Cache session/permission lookups (seconds; 0 = off). Recommended for a remote DB.
# AUTH_CACHE_TTL_SECONDS=20
# Run independent dashboard/analysis queries in parallel (0 = off). Recommended for a remote DB.
# REPORT_PARALLEL_LANES=6
