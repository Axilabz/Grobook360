# Backend production environment — set these in the host's env/secrets UI.
# NEVER commit real values.
ENVIRONMENT=production

# Supabase session pooler (port 5432). URL-encode special chars in the password (@ -> %40, ! -> %21).
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-eu-west-1.pooler.supabase.com:5432/postgres
DATABASE_SSL=true

# 32+ random chars, unique to production:  python -c "import secrets;print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=<generate-a-long-random-secret>

# Only needed when the frontend is on a DIFFERENT origin than the API.
# (Same-origin via a /api proxy needs no CORS.)  JSON list:
CORS_ALLOW_ORIGINS=["https://grobook360np.axilabz.com"]

# Speed-ups for a remote database (see backend/app/core/auth_cache.py, services/reports/parallel.py)
AUTH_CACHE_TTL_SECONDS=20
REPORT_PARALLEL_LANES=6
