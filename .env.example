# Root environment for docker-compose.yml. Copy to `.env` (gitignored) and fill in.
# Variable names match the existing backend/.env.example wherever possible.
# NEVER commit real values.

ENVIRONMENT=development

# Supabase PostgreSQL (session pooler, port 5432). URL-encode special characters in the password (@ -> %40).
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
DATABASE_SSL=true
DATABASE_USE_PGBOUNCER=false

# >= 32 chars. Gateway and backend must share it (gateway only verifies signatures).
JWT_SECRET_KEY=change-me-to-a-long-random-string-of-64-chars

CORS_ALLOW_ORIGINS=["http://localhost:3000"]
LOG_LEVEL=INFO
AUTH_CACHE_TTL_SECONDS=20

# --- Gateway ---
# passthrough = backend stays the only auth authority (default, no behaviour change)
# verify      = gateway also rejects missing/forged/expired tokens and stamps X-Tenant-Id
GATEWAY_AUTH_MODE=passthrough
GATEWAY_RATE_LIMIT_PER_MINUTE=0
# Phase 1B: per-service URLs. Empty = everything is served by the monolith.
SERVICE_URLS={}
